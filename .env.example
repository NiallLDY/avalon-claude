# 复制成 .env 后按需改。全部有默认值，不配也能跑。
# 默认值见 apps/server/src/config.ts

# ── 防滥用 ──
# ROOM_CREATE_PER_IP=3          # 单 IP 建房频率
# ROOM_CREATE_WINDOW_MS=600000  # 上面那个频率的窗口（10 分钟）
# MAX_ROOMS_PER_IP=2            # 单 IP 同时存在的房间数
# MAX_ROOMS=200                 # 全站房间上限
# MAX_SOCKETS_PER_IP=20         # 单 IP socket 连接数
# MSG_PER_WINDOW=30             # 单连接消息频率
# MSG_WINDOW_MS=10000
# MAX_PAYLOAD_BYTES=4096

# ── 生命周期 ──
# IDLE_ROOM_MS=1800000          # 全员离线 30 分钟回收房间
# FINISHED_ROOM_MS=7200000      # 对局结束 2 小时后回收
# HOST_TRANSFER_AFTER_MS=60000  # 房主掉线 60 秒后自动移交
# REPORT_TTL_SECONDS=604800     # 战报保留 7 天

# ── 可选 ──
# LOG_LEVEL=info
# TURNSTILE_SECRET=             # 设了才启用 Cloudflare Turnstile 建房校验
